{
  "name": "atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "test": "vitest run",
    "test:watch": "vitest",
    "loadtest": "tsx scripts/loadtest.ts",
    "smoke": "tsx scripts/smoke.ts",
    "eval": "tsx --conditions=react-server evals/run.ts",
    "eval:seed": "tsx --conditions=react-server evals/seed.ts",
    "eval:benchmark": "tsx --conditions=react-server evals/benchmark.ts",
    "eval:generation": "tsx --conditions=react-server evals/generation/benchmark.ts",
    "eval:isolation": "tsx --conditions=react-server evals/security/tenant-isolation.ts",
    "eval:injection": "tsx --conditions=react-server evals/security/injection.ts",
    "eval:reliability": "tsx --conditions=react-server evals/reliability/benchmark.ts",
    "eval:baseline": "tsx --conditions=react-server evals/baseline/benchmark.ts",
    "eval:regression": "tsx --conditions=react-server evals/regression/check.ts",
    "ingest:smoke": "tsx scripts/ingest-smoke.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "drizzle-orm": "^0.45.2",
    "motion": "^13.1.1",
    "next": "^16.3.3",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
