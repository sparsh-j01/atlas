# Copy to .env.local and fill in real values. .env.local is git-ignored.
# Source: Supabase project → Settings → API, and Settings → Database → Connection string.

# --- Public (safe in the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Server-only secret — BYPASSES RLS, never expose to the client ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Postgres (Drizzle) ---
# Pooled, Transaction mode, port 6543 — used by the app at runtime.
DATABASE_URL=postgresql://postgres.YOUR-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Direct, Session mode, port 5432 — used by Drizzle migrations only.
DIRECT_URL=postgresql://postgres.YOUR-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Optional but recommended: Supabase's root CA (Dashboard → Database → SSL Configuration →
# download), as PEM with \n escapes. Set, every DB connection verifies the server; unset,
# connections are encrypted but unverified. See lib/db/tls.ts.
# DATABASE_CA_CERT=

# --- AI provider (M6 deck generation) ---
# Gemini by default; the provider seam is lib/ai/generate.ts (swap via AI_PROVIDER).
# Get a key at https://aistudio.google.com/apikey — the free tier covers generation.
GEMINI_API_KEY=
# Optional: override the model (default gemini-3.7-flash). Worth setting: free-tier quota
# is counted per model per day, so when one model returns 429 another usually still answers.
# gemini-2.5-flash is no longer served to new API keys.
# GEMINI_MODEL=gemini-3.7-flash

# --- Cron (daily cleanup of abandoned uploads, scheduled in vercel.json) ---
# Vercel sends it as `Authorization: Bearer $CRON_SECRET`. Unset = the route refuses every
# call. Generate one with: openssl rand -hex 32
CRON_SECRET=

# --- AI spend protection (lib/usage.ts) ---
# Hard monthly cap on estimated Gemini spend, in USD. At 100% AI generation and document
# processing switch off for everyone until the month ends (UTC). Default 5.
AI_MONTHLY_BUDGET_USD=5
# Discord or Slack incoming-webhook URL for alerts: global spend at 80% / 100%, and a creator
# at 80% of their monthly AI decks. Each fires once a month. Unset = alerts go to the log only.
ALERT_WEBHOOK_URL=

# --- Bot protection (components/Turnstile.tsx) ---
# Cloudflare Turnstile site key (public). Set it AND enable CAPTCHA in Supabase (Auth → Attack
# Protection, provider Turnstile, with the secret key) together — one without the other either
# shows a widget nobody checks, or makes Supabase reject every sign-in for lack of a token.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
