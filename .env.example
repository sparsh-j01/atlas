# Copy to .env.local and fill in real values. .env.local is git-ignored.
# Source: Supabase project → Settings → API, and Settings → Database → Connection string.

# --- Public (safe in the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Server-only secret — BYPASSES RLS, never expose to the client ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Postgres (Drizzle) ---
# Pooled, Transaction mode, port 6543 — used by the app at runtime.
DATABASE_URL=postgresql://postgres.YOUR-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Direct, Session mode, port 5432 — used by Drizzle migrations only.
DIRECT_URL=postgresql://postgres.YOUR-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- AI provider (M6 deck generation) ---
# Gemini by default; the provider seam is lib/ai/generate.ts (swap via AI_PROVIDER).
# Get a key at https://aistudio.google.com/apikey — the free tier covers generation.
GEMINI_API_KEY=
# Optional: override the model (default gemini-3.7-flash). Worth setting: free-tier quota
# is counted per model per day, so when one model returns 429 another usually still answers.
# gemini-2.5-flash is no longer served to new API keys.
# GEMINI_MODEL=gemini-3.7-flash
